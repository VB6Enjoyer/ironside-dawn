{
  "name": "ironside-dawn",
  "private": true,
  "version": "0.0.0",
  "description": "A fantasy world simulation you watch rather than play.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim-cli.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  }
}
